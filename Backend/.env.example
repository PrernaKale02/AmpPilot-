# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. Never commit a real key, and never put a key in this file.

# Open Charge Map API key. Request one at:
#   https://openchargemap.org/site/develop/api
# Sent to OCM as an X-API-Key header, never as a query parameter, so it cannot
# leak through a logged URL. Required by /api/charging-stations; the app still
# boots and serves /health without it.
OPEN_CHARGE_MAP_API_KEY=your-open-charge-map-api-key-here

# Upstream timeout. Must stay well under the frontend's 10s axios timeout so
# the backend can return a clean error first.
OPEN_CHARGE_MAP_TIMEOUT_SECONDS=6.0

# Maximum POIs requested from OCM in a single call.
OPEN_CHARGE_MAP_MAX_RESULTS=50

# Comma-separated browser origins. React Native on iOS/Android ignores CORS
# entirely, so this only matters for Expo Web and Swagger UI.
# Leave empty to install no CORS middleware at all.
CORS_ALLOW_ORIGINS=http://localhost:8081,http://localhost:19006

# development | production
ENVIRONMENT=development
